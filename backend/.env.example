# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_NAME=KnowledgeX AI
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgex
POSTGRES_USER=knowledgex_user
POSTGRES_PASSWORD=change-me

# ── Qdrant Vector Store ───────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledgex_chunks
QDRANT_API_KEY=

# ── LLM API (leave blank – no LLM required to run) ───────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=none           # options: openai | anthropic | google | none

# ── Embedding ─────────────────────────────────────────────
EMBEDDING_PROVIDER=local    # options: openai | local
EMBEDDING_MODEL=text-embedding-3-small

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
